@page "/tempdata-early-streaming"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<h1>TempData early write with streaming</h1>

<p>
    The TempData value is assigned before the delay, but the page still streams
    before the delayed work completes.
</p>

<form method="post" @formname="TempDataEarlyStreaming" @onsubmit="HandleSubmitAsync">
    <div class="mb-3">
        <label class="form-label">
            Delay (milliseconds)
            <input class="form-control" type="number" name="DelayMilliseconds" value="@DelayMillisecondsValue" />
        </label>
    </div>

    <div class="mb-3">
        <label class="form-label">
            TempData message
            <input class="form-control" type="text" name="Message" value="@MessageValue" />
        </label>
    </div>

    <button class="btn btn-primary" type="submit">Assign first, then delay</button>
</form>

<p class="mt-3 mb-0">Status: @status</p>

@code {
    [CascadingParameter]
    public ITempData? TempData { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    public ILogger<TempDataEarlyWrite> Logger { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "TempDataEarlyStreaming")]
    public int? DelayMilliseconds { get; set; }

    [SupplyParameterFromForm(FormName = "TempDataEarlyStreaming")]
    public string? Message { get; set; }

    private string status = "Waiting for submission.";

    private int DelayMillisecondsValue => DelayMilliseconds ?? 1200;

    private string MessageValue => Message ?? "Early TempData assignment from the streaming page";

    private async Task HandleSubmitAsync()
    {
        SampleLog.Info(Logger, "StreamingTempDataEarlyWrite", "Cookie", "BeforeDelay", MessageValue, HttpContext);

        TempData!["TempDataMessage"] = MessageValue;
        SampleLog.Info(Logger, "StreamingTempDataEarlyWrite", "Cookie", "TempDataAssigned", MessageValue, HttpContext);
        status = $"TempData assigned, now waiting {DelayMillisecondsValue} ms.";
        await Task.Delay(DelayMillisecondsValue);

        SampleLog.Info(Logger, "StreamingTempDataEarlyWrite", "Cookie", "AfterDelayBeforeRedirect", MessageValue, HttpContext);
        NavigationManager.NavigateTo("/tempdata-reader", forceLoad: true);
    }
}