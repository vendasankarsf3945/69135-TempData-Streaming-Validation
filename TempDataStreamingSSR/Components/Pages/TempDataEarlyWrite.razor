@page "/tempdata-early-streaming"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<h1>TempData early write with streaming</h1>

<p>
    The TempData value is assigned before the delay, but the page still streams
    before the delayed work completes.
</p>

<form method="post" @formname="TempDataEarlyStreaming" @onsubmit="HandleSubmitAsync">
    <div class="mb-3">
        <label class="form-label">
            Delay (milliseconds)
            <input class="form-control" type="number" name="DelayMilliseconds" value="@DelayMilliseconds" />
        </label>
    </div>

    <div class="mb-3">
        <label class="form-label">
            TempData message
            <input class="form-control" type="text" name="Message" value="@Message" />
        </label>
    </div>

    <button class="btn btn-primary" type="submit">Assign first, then delay</button>
</form>

<p class="mt-3 mb-0">Status: @status</p>

@code {
    [CascadingParameter]
    public ITempData? TempData { get; set; }

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    public ILogger<TempDataEarlyWrite> Logger { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "TempDataEarlyStreaming")]
    public int DelayMilliseconds { get; set; } = 1200;

    [SupplyParameterFromForm(FormName = "TempDataEarlyStreaming")]
    public string? Message { get; set; } = "Early TempData assignment from the streaming page";

    private string status = "Waiting for submission.";

    private async Task HandleSubmitAsync()
    {
        Logger.LogInformation(
            "Response Started : {Time}",
            DateTime.Now);

        TempData!["TempDataMessage"] = Message;
        Logger.LogInformation(
            "TempData Assigned : {Time}",
            DateTime.Now);
        status = $"TempData assigned, now waiting {DelayMilliseconds} ms.";
        await Task.Delay(DelayMilliseconds);

        NavigationManager.NavigateTo("/tempdata-reader", forceLoad: true);
    }
}