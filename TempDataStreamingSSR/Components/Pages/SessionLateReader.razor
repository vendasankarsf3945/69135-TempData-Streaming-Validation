@page "/session-late-reader"
@using Microsoft.AspNetCore.Components

<h1>Session late reader</h1>

<p>
    This follow-up request checks whether the late-mounted child changed the
    session value after streaming had already started.
</p>

<p><strong>Session value:</strong> @SessionValue</p>

<p class="mb-0">
    If the late assignment happened after the response had already started, this
    should still remain the default value instead of `69135`.
</p>

@code {
    [SupplyParameterFromSession(Name = "sample_session_value")]
    public int SessionValue { get; set; }
}