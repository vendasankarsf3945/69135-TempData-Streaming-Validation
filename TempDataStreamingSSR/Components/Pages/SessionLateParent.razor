@page "/session-late-parent"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Http
@using TempDataStreamingSSR.Components.Shared

<h1>Session late-mount negative case</h1>

<p>
    This parent streams first and mounts the session-using child only after the
    delay, without any earlier session access in the render tree. The child then
    confirms that the response has already started, performs a late session
    assignment, and redirects to a follow-up reader page.
</p>

@if (!showChild)
{
    <p><em>Waiting before mounting the child...</em></p>
}
else
{
    <SessionLateChild />
}

@code {
    private bool showChild;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Inject]
    public ILogger<SessionLateParent> Logger { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        SampleLog.Info(Logger, "SessionLateNegative", "Session", "InitialRequest", null, HttpContext);

        await Task.Delay(millisecondsDelay: 1200);
        SampleLog.Info(Logger, "SessionLateNegative", "Session", "DelayCompleted", null, HttpContext);
        showChild = true;
        SampleLog.Info(Logger, "SessionLateNegative", "Session", "ChildRenderEnabled", null, HttpContext);
    }
}