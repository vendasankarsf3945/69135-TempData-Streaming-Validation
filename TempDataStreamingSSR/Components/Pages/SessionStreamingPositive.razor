@page "/session-streaming-positive"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<h1>Session streaming positive case</h1>

<p>
    The session value is supplied before the first flush, then updated after a
    controllable delay when the form is submitted.
</p>

<p><strong>Session value before first flush:</strong> @SessionValue</p>

<form method="post" @formname="SessionStreamingPositive" @onsubmit="UpdateSessionAsync">
    <div class="mb-3">
        <label class="form-label">
            Delay (milliseconds)
            <input class="form-control" type="number" name="DelayMilliseconds" value="@DelayMilliseconds" />
        </label>
    </div>

    <button class="btn btn-primary" type="submit">Delay and update session</button>
</form>

<p class="mt-3 mb-0">Status: @status</p>

@code {
    [SupplyParameterFromSession(Name = "sample_session_value")]
    public int SessionValue { get; set; }

    private object SubmitForm { get; } = new();

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Inject]
    public ILogger<SessionStreamingPositive> Logger { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "SessionStreamingPositive")]
    public int? DelayMilliseconds { get; set; }

    private string status = "Waiting for submission.";

    private int DelayMillisecondsValue => DelayMilliseconds ?? 1200;

    private async Task UpdateSessionAsync()
    {
        SampleLog.Info(Logger, "SessionStreamingPositive", "Session", "BeforeDelay", SessionValue, HttpContext);

        status = $"Waiting {DelayMillisecondsValue} ms before updating session.";
        await Task.Delay(DelayMillisecondsValue);

        SampleLog.Info(Logger, "SessionStreamingPositive", "Session", "AfterDelayBeforeSessionWrite", SessionValue, HttpContext);
        SessionValue++;
        SampleLog.Info(Logger, "SessionStreamingPositive", "Session", "SessionAssigned", SessionValue, HttpContext);
        status = $"Session updated to {SessionValue}. Refresh to confirm the value persists.";
    }
}