@page "/tempdata-early-nonstreaming"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<h1>TempData early write without streaming</h1>

<p>
    The TempData value is assigned before the delay, but this page does not use
    streaming rendering, so the response stays blocked until the delay finishes.
</p>

<form method="post" @formname="TempDataEarlyNonStreaming" @onsubmit="HandleSubmitAsync">
    <div class="mb-3">
        <label class="form-label">
            Delay (milliseconds)
            <input class="form-control" type="number" name="DelayMilliseconds" value="@DelayMillisecondsValue" />
        </label>
    </div>

    <div class="mb-3">
        <label class="form-label">
            TempData message
            <input class="form-control" type="text" name="Message" value="@MessageValue" />
        </label>
    </div>

    <button class="btn btn-primary" type="submit">Assign first, then delay</button>
</form>

<p class="mt-3 mb-0">Status: @status</p>

@code {
    [CascadingParameter]
    public ITempData? TempData { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    public ILogger<TempDataEarlyWriteStatic> Logger { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "TempDataEarlyNonStreaming")]
    public int? DelayMilliseconds { get; set; }

    [SupplyParameterFromForm(FormName = "TempDataEarlyNonStreaming")]
    public string? Message { get; set; }

    private string status = "Waiting for submission.";

    private int DelayMillisecondsValue => DelayMilliseconds ?? 1200;

    private string MessageValue => Message ?? "Early TempData assignment from the nonstreaming page";

    private async Task HandleSubmitAsync()
    {
        var storageMode = SampleLog.ResolveStorageMode(HttpContext);
        SampleLog.Info(Logger, "NonStreamingTempDataEarlyWrite", storageMode, "BeforeDelay", MessageValue, HttpContext);

        TempData!["TempDataMessage"] = MessageValue;
        SampleLog.Info(Logger, "NonStreamingTempDataEarlyWrite", storageMode, "TempDataAssigned", MessageValue, HttpContext);
        status = $"TempData assigned, now waiting {DelayMillisecondsValue} ms.";
        await Task.Delay(DelayMillisecondsValue);

        SampleLog.Info(Logger, "NonStreamingTempDataEarlyWrite", storageMode, "AfterDelayBeforeRedirect", MessageValue, HttpContext);
        NavigationManager.NavigateTo("/tempdata-reader", forceLoad: true);
    }
}