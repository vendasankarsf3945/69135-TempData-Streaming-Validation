@page "/tempdata-streaming-write"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.Endpoints
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<h1>TempData streaming write</h1>

<p>
    This page renders its heading immediately, reads session before the first
    flush, waits for a controllable delay, writes TempData, and redirects to an
    ordinary reader page.
</p>

<p><strong>Session value before first flush:</strong> @SessionValue</p>

<form method="post" @formname="TempDataStreamingWrite" @onsubmit="HandleSubmitAsync">
    <div class="mb-3">
        <label class="form-label">
            Delay (milliseconds)
            <input class="form-control" type="number" name="DelayMilliseconds" value="@DelayMilliseconds" />
        </label>
    </div>

    <div class="mb-3">
        <label class="form-label">
            TempData message
            <input class="form-control" type="text" name="Message" value="@Message" />
        </label>
    </div>

    <button class="btn btn-primary" type="submit">Write TempData and redirect</button>
</form>

<p class="mt-3 mb-0">Status: @status</p>

@code {
    [CascadingParameter]
    public ITempData? TempData { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromSession(Name = "sample_session_value")]
    public int SessionValue { get; set; }

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    public ILogger<StreamingValidation> Logger { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "TempDataStreamingWrite")]
    public int? DelayMilliseconds { get; set; }

    [SupplyParameterFromForm(FormName = "TempDataStreamingWrite")]
    public string? Message { get; set; }

    private string status = "Waiting for submission.";

    private int DelayMillisecondsValue => DelayMilliseconds ?? 1200;

    private string MessageValue => Message ?? "Flash message from the streaming writer";

    private async Task HandleSubmitAsync()
    {
        SampleLog.Info(Logger, "StreamingTempDataWrite", "Cookie", "BeforeDelay", MessageValue, HttpContext);

        status = $"Waiting {DelayMillisecondsValue} ms before writing TempData.";
        await Task.Delay(DelayMillisecondsValue);

        SampleLog.Info(Logger, "StreamingTempDataWrite", "Cookie", "AfterDelayBeforeTempDataWrite", MessageValue, HttpContext);
        TempData![TempDataMessage] = MessageValue;
        SampleLog.Info(Logger, "StreamingTempDataWrite", "Cookie", "TempDataAssigned", MessageValue, HttpContext);
        NavigationManager.NavigateTo("/tempdata-reader", forceLoad: true);
    }

    private const string TempDataMessage = "TempDataMessage";
}
