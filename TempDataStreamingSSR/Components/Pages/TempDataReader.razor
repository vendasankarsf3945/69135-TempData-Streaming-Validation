@page "/tempdata-reader"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Endpoints

<h1>TempData reader</h1>

<p>This page reads TempData once and shows the message captured by the redirect.</p>

<p><strong>Message:</strong> @(message ?? "No TempData message was available.")</p>

<p>Refresh the page to confirm the value was consumed on the first read.</p>

@code {
    [CascadingParameter]
    public ITempData? TempData { get; set; }

    private string? message;

    protected override void OnInitialized()
    {
        // Use Get so TempData is consumed on first read for one-time message behavior.
        message = TempData?.Get("TempDataMessage") as string;
    }
}